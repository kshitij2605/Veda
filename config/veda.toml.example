# Veda Configuration File
# Copy this to veda.toml and adjust settings as needed.

[gateway]
# Listen address for the REST API.
listen = "0.0.0.0:6340"

[data]
# Local data directory path.
dir = "./veda-data"

[flashparse]
# FlashParse OCR endpoint (optional -- only needed for document processing).
# Set to empty string or remove to disable document processing.
# Default: http://flashparse:8000 (Docker Compose service name)
endpoint = "http://flashparse:8000"
