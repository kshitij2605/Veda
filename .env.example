# Veda Configuration
# Copy this file to .env and fill in the values

# -- Storage ----------------------------------------------------------
MINIO_PASSWORD=vedapassword

# -- Authentication ---------------------------------------------------
VEDA_JWT_SECRET=change-me-to-a-secure-random-string
VEDA_ADMIN_PASSWORD=admin

# -- FlashParse OCR (optional -- only needed with --profile ocr) ------
# Endpoint for the Vision Language Model used by FlashParse
# Supports any OpenAI-compatible API: vLLM, SGLang, OpenAI, Together AI, etc.
VLM_ENDPOINT=http://host.docker.internal:8008/v1/chat/completions
VLM_API_KEY=
VLM_MODEL=

# -- Embedding Models (optional -- for auto-embedding) ----------------
# Configure embedding model endpoints for automatic vector generation
# VEDA_EMBEDDING_CLIP_ENDPOINT=http://localhost:8080/v1/embeddings
# VEDA_EMBEDDING_CLIP_MODEL=clip-vit-l-14

# -- FlashParse Service -----------------------------------------------
# Override FlashParse endpoint (default: http://flashparse:8000 in Docker)
# VEDA_FLASHPARSE_ENDPOINT=http://flashparse:8000

# -- Logging ----------------------------------------------------------
RUST_LOG=info
