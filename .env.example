# Veda Configuration
# Copy this file to .env and fill in the values

# ── Storage ─────────────────────────────────────────────────
MINIO_PASSWORD=vedapassword

# ── Authentication ──────────────────────────────────────────
VEDA_JWT_SECRET=change-me-to-a-secure-random-string
VEDA_ADMIN_PASSWORD=admin

# ── Embedding Service ───────────────────────────────────────
# Option 1: Use Docker Compose profile (self-contained)
#   docker compose --profile embedding up
#   Uses HuggingFace TEI with the model below
# Option 2: Point to your own server
#   Set EMBEDDING_ENDPOINT to your server URL
EMBEDDING_ENDPOINT=http://embedding:80
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ── VLM Service (for FlashParse image captioning) ──────────
# Option 1: Use Docker Compose profile (self-contained, ~48GB VRAM)
#   docker compose --profile vlm up
#   Runs Qwen/Qwen3.5-35B-A3B-FP8 on vLLM with MTP-1
# Option 2: Point to your own server
#   Set VLM_ENDPOINT to your server URL
VLM_ENDPOINT=http://vlm:8008/v1/chat/completions
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen3.5-35B-A3B-FP8

# ── GLM-OCR Service (for FlashParse text/table OCR) ────────
# Option 1: Use Docker Compose profile (self-contained, ~8GB VRAM)
#   docker compose --profile glm-ocr up
# Option 2: Point to your own server
#   Set GLMOCR_API_HOST and GLMOCR_API_PORT
GLMOCR_API_HOST=glm-ocr
GLMOCR_API_PORT=8080

# ── FlashParse OCR ──────────────────────────────────────────
# Enabled with: docker compose --profile ocr up
# Requires VLM and GLM-OCR services (via profiles or external)
# VEDA_FLASHPARSE_ENDPOINT=http://flashparse:8000

# ── Hugging Face Token (for gated models) ───────────────────
# Required if using gated models like Qwen VL
# HF_TOKEN=hf_xxxxx

# ── Logging ─────────────────────────────────────────────────
RUST_LOG=info
